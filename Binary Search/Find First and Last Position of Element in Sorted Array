/*
------------------------------------------------------------
Problem    : Find First and Last Position of Element in Sorted Array
Platform   : LeetCode
Topic      : Binary Search
Difficulty : Medium

Problem:
Given a sorted array of integers and a target value, return
the starting and ending positions of the target.

If the target does not exist, return {-1, -1}.

The solution must run in O(log n) time.

Approach:
Use Binary Search twice.

The first search finds the leftmost (first) occurrence of
the target by continuing the search in the left half after
finding the target.

The second search finds the rightmost (last) occurrence by
continuing the search in the right half after finding the
target.

Why does this work?

A standard Binary Search stops as soon as the target is
found.

To locate the first occurrence, continue searching toward
the left even after finding the target.

Similarly, to locate the last occurrence, continue searching
toward the right.

Since each search halves the search space, both searches
together still run in O(log n) time.

Algorithm:
1. Perform Binary Search to find the first occurrence.
2. Perform Binary Search to find the last occurrence.
3. Return both indices.
4. If the target is absent, return {-1, -1}.

Time Complexity : O(log n)

Reason:
Two Binary Searches are performed, each taking O(log n).

Space Complexity : O(1)

Reason:
Only a constant number of variables are used.

------------------------------------------------------------
*/

class Solution {
private:

    // Finds the first occurrence of the target.
    int findFirstOccurrence(vector<int>& nums, int target) {

        int low = 0;
        int high = nums.size() - 1;
        int firstIndex = -1;

        while (low <= high) {

            int mid = low + (high - low) / 2;

            if (nums[mid] == target) {

                firstIndex = mid;
                high = mid - 1;
            }
            else if (nums[mid] < target) {

                low = mid + 1;
            }
            else {

                high = mid - 1;
            }
        }

        return firstIndex;
    }

    // Finds the last occurrence of the target.
    int findLastOccurrence(vector<int>& nums, int target) {

        int low = 0;
        int high = nums.size() - 1;
        int lastIndex = -1;

        while (low <= high) {

            int mid = low + (high - low) / 2;

            if (nums[mid] == target) {

                lastIndex = mid;
                low = mid + 1;
            }
            else if (nums[mid] < target) {

                low = mid + 1;
            }
            else {

                high = mid - 1;
            }
        }

        return lastIndex;
    }

public:
    vector<int> searchRange(vector<int>& nums, int target) {

        int firstIndex = findFirstOccurrence(nums, target);
        int lastIndex = findLastOccurrence(nums, target);

        return {firstIndex, lastIndex};
    }
};
