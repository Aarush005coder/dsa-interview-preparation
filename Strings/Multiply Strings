/*
------------------------------------------------------------
Problem    : Multiply Strings
Platform   : LeetCode
Topic      : Strings
Difficulty : Medium

Problem:
Given two non-negative integers represented as strings,
return their product as a string.

The numbers can be too large to fit into standard integer
types, so direct integer conversion is not allowed.

Approach:
Simulate the multiplication process that we normally perform
on paper.

For every digit in num1, multiply it with every digit in num2
and store the result in the appropriate position of an integer
array.

If num1 has n digits and num2 has m digits, their product can
contain at most n + m digits.

For digits at positions i and j, their product contributes to:

    res[i + j + 1]

Any carry is stored at:

    res[i + j]

Why does this work?

The multiplication of two decimal numbers can be performed
digit by digit.

For example:

    123 × 456

Each digit multiplication contributes to its corresponding
place value, and the result array stores these values while
handling carries.

Using an array of size n + m guarantees enough space for the
maximum possible number of digits.

After all multiplications are complete, the leading zeroes
are removed and the remaining digits are converted into a
string.

Algorithm:
1. If either number is "0", return "0".
2. Create an array of size n + m initialized with zeroes.
3. Traverse both numbers from right to left.
4. Multiply every pair of digits.
5. Add the product and existing value at the result position.
6. Store the current digit and carry separately.
7. Convert the result array into a string.
8. Remove leading zeroes.

Time Complexity : O(n × m)

Reason:
Every digit of num1 is multiplied with every digit of num2.

Space Complexity : O(n + m)

Reason:
The result array requires at most n + m positions.

------------------------------------------------------------
*/

class Solution {
public:
    string multiply(string num1, string num2) {

        // If either number is zero, the product is zero.
        if (num1 == "0" || num2 == "0") {
            return "0";
        }

        int n = num1.size();
        int m = num2.size();

        // The product of n and m digit numbers
        // can contain at most n + m digits.
        vector<int> result(n + m, 0);

        // Multiply digits from right to left.
        for (int i = n - 1; i >= 0; i--) {

            for (int j = m - 1; j >= 0; j--) {

                int product =
                    (num1[i] - '0') * (num2[j] - '0');

                int sum = product + result[i + j + 1];

                // Store the current digit.
                result[i + j + 1] = sum % 10;

                // Store the carry.
                result[i + j] += sum / 10;
            }
        }

        string answer;
        bool leadingZero = true;

        // Convert the result array into a string
        // while skipping leading zeroes.
        for (int digit : result) {

            if (leadingZero && digit == 0) {
                continue;
            }

            leadingZero = false;
            answer += char(digit + '0');
        }

        return answer;
    }
};
